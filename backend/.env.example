# Fastify Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/raize_fitness

# Upstash Redis & QStash Configuration
REDIS_URL=redis://localhost:6379
QSTASH_URL=https://qstash.upstash.io/v2/publish
QSTASH_TOKEN=mock_qstash_token

# JWT Secret Key
JWT_SECRET=raize_super_secret_jwt_signing_key_at_least_32_characters_long

# SendByte Transactional Email Service (@sendbyte/node)
SENDBYTE_API_KEY=sb_live_mock_key
SENDBYTE_SENDER_EMAIL=noreply@raize.fit

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_test_mock_paystack_secret
PAYSTACK_PUBLIC_KEY=pk_test_mock_paystack_public

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=mock_r2_account
R2_ACCESS_KEY_ID=mock_r2_access_key
R2_SECRET_ACCESS_KEY=mock_r2_secret_key
R2_BUCKET_NAME=raize-media-prod
R2_PUBLIC_DOMAIN=https://media.raize.fit

# Argon2id Field-Level Envelope Encryption Key Ring
HEALTH_DATA_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HEALTH_DATA_KEY_V2=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
HEALTH_DATA_ACTIVE_VERSION=2
